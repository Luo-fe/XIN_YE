[
  { "id": "m2", "date": "2023-06-27", "mood": "happy", "text": "第二次聊天，茹玉昕拍了拍我，说不是孤军奋战了", "images": [] },
  { "id": "m3", "date": "2023-08-11", "mood": "happy", "text": "深夜长谈从工作聊到生活，氛围轻松愉快，晚安后还多聊了几句", "images": [] },
  { "id": "m4", "date": "2023-08-22", "mood": "calm", "text": "选课大讨论，两人默契度和亲密度在上升", "images": [] },
  { "id": "m6", "date": "2023-09-27", "mood": "sad", "text": "拉群争执，凌晨0点讨论部门工作节奏，她说听我的这不好", "images": [] },
  { "id": "m7", "date": "2023-09-28", "mood": "excited", "text": "深夜一起听歌，拍了拍她指了指天空看烟花，主动提出太原南站接站", "images": [] },
  { "id": "m8", "date": "2023-10-01", "mood": "excited", "text": "凌晨四点的奇迹，一句早竟换来秒回，错开三分钟这消息都看不见", "images": [] },
  { "id": "m10", "date": "2023-10-31", "mood": "calm", "text": "为她解答金星之谜，收获两朵玫瑰表情，解答了我的疑惑", "images": [] },
  { "id": "m12", "date": "2023-11-08", "mood": "excited", "text": "星之咒语，深夜多语言想你了咒语，生活灰头土脸却能让沙漠开出蔷薇", "images": [] },
  { "id": "m13", "date": "2023-11-11", "mood": "happy", "text": "光棍节深夜回顾恋爱时间线，你已经被我绑住了跑不掉", "images": [] },
  { "id": "m14", "date": "2023-11-30", "mood": "happy", "text": "甜蜜日常，抱抱抱好想你惹，来姐姐怀里睡觉觉", "images": [] },
  { "id": "m15", "date": "2023-12-01", "mood": "happy", "text": "确立恋爱后第一个完整月，昵称升级为宝宝宝贝昕昕公主", "images": [] },
  { "id": "m16", "date": "2023-12-09", "mood": "happy", "text": "圣诞礼物玩笑，我就敢让你见不到圣诞第二天的太阳", "images": [] },
  { "id": "m19", "date": "2024-01-15", "mood": "calm", "text": "长安落雪，两人一起赏雪，她在西安发来落雪照片", "images": [] },
  { "id": "m20", "date": "2024-01-25", "mood": "sad", "text": "寒假异地想念，又想你了，我想抱着你睡呜呜呜", "images": [] },
  { "id": "m21", "date": "2024-02-05", "mood": "excited", "text": "异地想念浓度极高，超级无敌爆炸爱你宇宙无敌爱你刷屏", "images": [] },
  { "id": "m23", "date": "2024-02-17", "mood": "sad", "text": "退票事件小摩擦，她让他退票后主动道歉，我只是比较害怕", "images": [] },
  { "id": "m24", "date": "2024-02-29", "mood": "sad", "text": "月末首次明显冷战，她说我们都各自冷静几天，陷入冷战", "images": [] },
  { "id": "m25", "date": "2024-03-01", "mood": "calm", "text": "冷战和好，我会失去你吗？不会。我会好好改过自新重新做人", "images": [] },
  { "id": "m26", "date": "2024-03-07", "mood": "sad", "text": "小摩擦余波，别给我发照片，我的烂脾气你没必要包容忍耐", "images": [] },
  { "id": "m28", "date": "2024-03-31", "mood": "sad", "text": "分别后强烈想念，宝宝我真的好想你，脑子里还有你头发的香味", "images": [] },
  { "id": "m29", "date": "2024-04-04", "mood": "sad", "text": "清明半夜焦虑，宝宝能不能别不理我，我只是比较害怕", "images": [] },
  { "id": "m30", "date": "2024-04-15", "mood": "excited", "text": "邓紫棋演唱会筹备期待，好期待演唱会，研究票价拼房", "images": [] },
  { "id": "m31", "date": "2024-04-30", "mood": "calm", "text": "回归校园稳定甜蜜，每天都会见面，安全感大幅回升", "images": [] },
  { "id": "m32", "date": "2024-05-01", "mood": "calm", "text": "五一假期相伴，老夫老妻般的自在相处，聊天尺度很日常随意", "images": [] },
  { "id": "m35", "date": "2024-05-25", "mood": "sad", "text": "弄坏手作自责，我好难过它坏了我是不是有点笨啊", "images": [] },
  { "id": "m36", "date": "2024-06-10", "mood": "calm", "text": "端午线下一起度过，平淡温馨的日常相处", "images": [] },
  { "id": "m37", "date": "2024-06-15", "mood": "sad", "text": "期末考试焦虑，数学统计让她崩溃，上了三次厕所脆弱的肚子", "images": [] },
  { "id": "m38", "date": "2024-06-26", "mood": "sad", "text": "暑假分别不舍，我也想跟你回家呜呜X﹏X", "images": [] },
  { "id": "m40", "date": "2024-07-17", "mood": "calm", "text": "深夜情感探讨，试探表白修正关系，她坚持不可有非分之想", "images": [] },
  { "id": "m41", "date": "2024-07-25", "mood": "excited", "text": "暑期热恋如胶似漆，宝宝爱你亲亲贯穿全月，消息量峰值", "images": [] },
  { "id": "m45", "date": "2024-08-31", "mood": "tired", "text": "开学筹备忙碌，综测辅修学生会迎新事务密集，略显操劳", "images": [] },
  { "id": "m48", "date": "2024-09-24", "mood": "calm", "text": "这么腻歪咱俩都快一年了，根本离不开，这是客观事实", "images": [] },
  { "id": "m51", "date": "2024-11-01", "mood": "calm", "text": "一起煮火锅，商量底料蘸料买食材，烟火气十足", "images": [] },
  { "id": "m54", "date": "2024-11-22", "mood": "happy", "text": "想送你一万朵小花，给你一个么么哒，爱你爱你爱你", "images": [] },
  { "id": "m55", "date": "2024-12-01", "mood": "sad", "text": "熬夜冲突，我还是很生气你熬夜，你跟我在一起也闷闷的还凶巴巴", "images": [] },
  { "id": "m56", "date": "2024-12-11", "mood": "sad", "text": "父亲胸骨摔伤，今天刚刚从武汉医院复查了回家，家庭变故带来压力", "images": [] },
  { "id": "m59", "date": "2025-01-10", "mood": "tired", "text": "期末考试周疲惫，数科考试压力，互相加油打气", "images": [] },
  { "id": "m60", "date": "2025-01-28", "mood": "sad", "text": "看旧照怀念难过，过得太快了好难过，思念对方", "images": [] },
  { "id": "m62", "date": "2025-02-05", "mood": "sad", "text": "异地思念密集，超级无敌想你想你不睡觉", "images": [] },
  { "id": "m64", "date": "2025-02-16", "mood": "happy", "text": "开学重逢，从异地切换到朝夕相处，情绪由想念转为陪伴的安心", "images": [] },
  { "id": "m66", "date": "2025-03-15", "mood": "happy", "text": "爱你出现频率为半年最高，感情表达直接浓烈且稳定", "images": [] },
  { "id": "m67", "date": "2025-03-29", "mood": "calm", "text": "日常校园琐事，早起找车子上课，不要学太晚", "images": [] },
  { "id": "m68", "date": "2025-04-01", "mood": "sad", "text": "牙疼发作剧烈，去校医院就诊洗牙，因牙疼情绪低落", "images": [] },
  { "id": "m69", "date": "2025-04-04", "mood": "sad", "text": "清明分别不舍，临行视频亲亲，依依不舍", "images": [] },
  { "id": "m70", "date": "2025-04-25", "mood": "sad", "text": "小争吵，觉得被忽视感与付出不对等的错位，我挺累了", "images": [] },
  { "id": "m71", "date": "2025-04-26", "mood": "tired", "text": "身体不适，没醒对不起我有点难受", "images": [] },
  { "id": "m72", "date": "2025-05-01", "mood": "happy", "text": "五一假期轻松愉快，榴莲披萨榴莲千层美食话题", "images": [] },
  { "id": "m73", "date": "2025-05-20", "mood": "calm", "text": "520平淡陪伴，深夜互相送还物品，今天很辛苦了", "images": [] },
  { "id": "m74", "date": "2025-05-31", "mood": "sad", "text": "深夜袒露心声谈母亲辛苦，你让我对未来有很多期待，哭着说出心里话", "images": [] },
  { "id": "m75", "date": "2025-06-01", "mood": "happy", "text": "六一儿童节互逗，六一昕昕小孩快乐呀，童趣玩闹", "images": [] },
  { "id": "m76", "date": "2025-06-14", "mood": "excited", "text": "密集表白，超级无敌爆炸爱你超级加倍爱你，甜度峰值", "images": [] },
  { "id": "m78", "date": "2025-06-29", "mood": "calm", "text": "安慰因睫毛急哭的她，没事宝宝慢慢来现在都进步到现在再慢慢进步", "images": [] },
  { "id": "m79", "date": "2025-07-12", "mood": "sad", "text": "培训焦虑，主要我啥也不会，气死我了大哭", "images": [] },
  { "id": "m80", "date": "2025-07-15", "mood": "calm", "text": "哥哥生日家宴，吃辣子鸡小龙虾螃蟹大餐", "images": [] },
  { "id": "m81", "date": "2025-07-25", "mood": "calm", "text": "讨论宝剑嫂分手，反思情侣合作关系，关系稳定", "images": [] },
  { "id": "m82", "date": "2025-07-31", "mood": "happy", "text": "暑假温暖稳定，每晚爱你已成固定仪式，发语音亲我几口", "images": [] },
  { "id": "m83", "date": "2025-08-05", "mood": "sad", "text": "女生发烧叠buff生理期，四肢酸痛，发烧是白细胞大军跟病毒赌命", "images": [] },
  { "id": "m88", "date": "2025-09-01", "mood": "happy", "text": "开学重聚，一起去图书馆学习，日常紧密相伴", "images": [] },
  { "id": "m92", "date": "2025-10-01", "mood": "happy", "text": "童年影像分享，小学珍贵影像穿粉围巾唱跳视频，现在是优雅的公主了", "images": [] },
  { "id": "m94", "date": "2025-10-09", "mood": "excited", "text": "国庆后重逢，明天我要亲个够我碎了，去车站接她", "images": [] },
  { "id": "m95", "date": "2025-10-31", "mood": "calm", "text": "学业压力下相互打气，刷政治达标题，是彼此的精神支撑", "images": [] },
  { "id": "m97", "date": "2025-11-11", "mood": "sad", "text": "双十一考研抱怨，我恨李林花了那么多钱，改做早年数学真题", "images": [] },
  { "id": "m98", "date": "2025-11-16", "mood": "calm", "text": "帮父母网上打车回宣化，幸苦宝宝了", "images": [] },
  { "id": "m99", "date": "2025-11-30", "mood": "happy", "text": "放了六次烟花视频分享，找我小叶叶展现主动亲昵", "images": [] },
  { "id": "m100", "date": "2025-12-01", "mood": "tired", "text": "考研冲刺，宿舍复习党史政治，计划去图书馆按计划写", "images": [] },
  { "id": "m106", "date": "2026-01-13", "mood": "sad", "text": "喝酒小插曲吃醋，以后在北京你不能这么喝哈，都不理我了难过", "images": [] },
  { "id": "m110", "date": "2026-01-27", "mood": "calm", "text": "互送礼物新阶段，之前是之前啊，开启互送礼物的仪式感", "images": [] },
  { "id": "m115", "date": "2026-02-19", "mood": "sad", "text": "考研出分焦虑，每天随机时间想起考研成绩然后心脏扑通扑通乱跳", "images": [] },
  { "id": "m117", "date": "2026-03-13", "mood": "sad", "text": "等复试通知焦虑，啊啊啊怎么还不发复试通知这不是跟凌迟一样", "images": [] },
  { "id": "m118", "date": "2026-03-26", "mood": "happy", "text": "深情告白，我不要上天我只要小昕昕的奖励，只要有你就足够了", "images": [] },
  { "id": "m119", "date": "2026-03-27", "mood": "sad", "text": "复试前夜紧张，好紧张和妈妈视频，女生贴心照顾吃鸡公煲", "images": [] },
  { "id": "m121", "date": "2026-03-31", "mood": "calm", "text": "归程翻旧照怀旧，现在看起来都是回忆了，感情在共同回忆中沉淀", "images": [] },
  { "id": "m128", "date": "2026-05-05", "mood": "happy", "text": "红包爱你勾勾蛋，为啥给我这么多好感人，争吵后更珍惜彼此", "images": [] },
  { "id": "m129", "date": "2026-05-11", "mood": "sad", "text": "可我还是很难过也很讨厌我并没有那么好", "images": [] },
  { "id": "m130", "date": "2026-05-21", "mood": "happy", "text": "芋芋试衣服好好看！", "images": [] },
  { "id": "m131", "date": "2026-05-23", "mood": "calm", "text": "感觉心里很踏实，也许是因为小昕昕就在身边", "images": [] },
  { "id": "m132", "date": "2026-05-26", "mood": "excited", "text": "小昕昕豪赢两把！", "images": [] },
  { "id": "m135", "date": "2026-07-14", "mood": "calm", "text": "没有花的世界是多么单调啊 没有你那么我的世界是多么无聊啊", "images": [] }
]
